        msg="unexpected expansion: " + actual,
      )
    }
  }
}

///|
fn fixture_1_1() -> @lib.Variables {
  let vars = @lib.Variables::new()
  vars.set("count", @lib.List(["one", "two", "three"]))
  vars.set("dom", @lib.List(["example", "com"]))
  vars.set("dub", @lib.Scalar("me/too"))
  vars.set("hello", @lib.Scalar("Hello World!"))
  vars.set("half", @lib.Scalar("50%"))
  vars.set("var", @lib.Scalar("value"))
  vars.set("who", @lib.Scalar("fred"))
  vars.set("base", @lib.Scalar("http://example.com/home/"))
  vars.set("path", @lib.Scalar("/foo/bar"))
  vars.set("list", @lib.List(["red", "green", "blue"]))
  vars.set(
    "keys",
    @lib.Assoc(
      @lib.OrderedEntries::from_entries([
        ("semi", ";"),
        ("dot", "."),
        ("comma", ","),
      ]).unwrap(),
    ),
  )
  vars.set("v", @lib.Scalar("6"))
  vars.set("x", @lib.Scalar("1024"))
  vars.set("y", @lib.Scalar("768"))
  vars.set("empty", @lib.Scalar(""))
  vars.set(
    "empty_keys",
    @lib.Assoc(@lib.OrderedEntries::from_entries([]).unwrap()),
  )
  vars
}

///|
test "spec-examples-by-section.json/1/0/L4" {
  let result = @lib.expand("{count}", fixture_1_1())
  match result {
    Err(e) => fail(e.code + ": " + e.message)
    Ok(actual) => {
      let expected : Array[String] = ["one,two,three"]
      assert_true(
        expected.contains(actual),
        msg="unexpected expansion: " + actual,
      )
    }
  }
}

