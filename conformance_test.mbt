  let result = @lib.expand("{/keys*}", fixture_0_3())
  match result {
    Err(e) => fail(e.code + ": " + e.message)
    Ok(actual) => {
      let expected : Array[String] = [
        "/comma=%2C/dot=./semi=%3B", "/comma=%2C/semi=%3B/dot=.", "/dot=./comma=%2C/semi=%3B",
        "/dot=./semi=%3B/comma=%2C", "/semi=%3B/comma=%2C/dot=.", "/semi=%3B/dot=./comma=%2C",
      ]
      assert_true(
        expected.contains(actual),
        msg="unexpected expansion: " + actual,
      )
    }
  }
}

