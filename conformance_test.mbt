///|
fn fixture_1_0() -> @lib.Variables {
  let vars = @lib.Variables::new()
  vars.set("count", @lib.List(["one", "two", "three"]))
  vars
}

///|
test "spec-examples-by-section.json/0/0/L4" {
  let result = @lib.expand("'{count}'", fixture_1_0())
  match result {
    Err(e) => fail(e.code + ": " + e.message)
    Ok(actual) => {
