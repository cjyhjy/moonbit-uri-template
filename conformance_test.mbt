///|
fn fixture_3_0() -> @lib.Variables {
  let vars = @lib.Variables::new()
  vars.set("id", @lib.Scalar("thing"))
  vars.set("var", @lib.Scalar("value"))
  vars.set("hello", @lib.Scalar("Hello World!"))
  vars.set("with space", @lib.Scalar("fail"))
  vars.set(" leading_space", @lib.Scalar("Hi!"))
  vars.set("trailing_space ", @lib.Scalar("Bye!"))
  vars.set("empty", @lib.Scalar(""))
  vars.set("path", @lib.Scalar("/foo/bar"))
  vars.set("x", @lib.Scalar("1024"))
  vars.set("y", @lib.Scalar("768"))
  vars.set("list", @lib.List(["red", "green", "blue"]))
  vars.set(
    "keys",
    @lib.Assoc(
      @lib.OrderedEntries::from_entries([
        ("semi", ";"),
        ("dot", "."),
        ("comma", ","),
      ]).unwrap(),
    ),
  )
  vars.set("example", @lib.Scalar("red"))
  vars.set("searchTerms", @lib.Scalar("uri templates"))
  vars.set("~thing", @lib.Scalar("some-user"))
  vars.set(
    "default-graph-uri",
    @lib.List(["http://www.example/book/", "http://www.example/papers/"]),
  )
  vars.set(
    "query",
    @lib.Scalar(
      "PREFIX dc: <http://purl.org/dc/elements/1.1/> SELECT ?book ?who WHERE { ?book dc:creator ?who }",
    ),
  )
  vars
}

