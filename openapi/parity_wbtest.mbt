///|
test "JS analysis parity fixture 13" {
  let doc = @json.parse(
    "{\"openapi\":\"3.1.0\",\"paths\":{\"/a\":{\"get\":{\"operationId\":\"x\"}},\"/b\":{\"get\":{\"operationId\":\"x\"}}}}",
  )
  let expected = @json.parse(
    "{\"schemaVersion\":2,\"ok\":false,\"complete\":true,\"operations\":[{\"id\":\"x\",\"method\":\"GET\",\"path\":\"/a\",\"template\":\"/a\",\"parameters\":[],\"unsupported\":[],\"example\":\"/a\"},{\"id\":\"x\",\"method\":\"GET\",\"path\":\"/b\",\"template\":\"/b\",\"parameters\":[],\"unsupported\":[],\"example\":\"/b\"}],\"diagnostics\":[{\"code\":\"DuplicateOperationId\",\"severity\":\"error\",\"message\":\"operationId x is also used by GET /a\",\"path\":\"/paths/~1b/get/operationId\"}],\"truncated\":{\"errors\":0,\"warnings\":0}}",
  )
  assert_eq(analyze(doc).to_json(), expected)
}

