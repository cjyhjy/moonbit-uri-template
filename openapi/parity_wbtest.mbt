test "JS analysis parity fixture 14" {
  let doc = @json.parse(
    "{\"openapi\":\"3.1.0\",\"paths\":{\"/repos/{owner}/{repo}/commits\":{\"parameters\":[{\"name\":\"owner\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"name\":\"repo\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"get\":{\"operationId\":\"repos/list-commits\",\"parameters\":[{\"name\":\"per_page\",\"in\":\"query\",\"schema\":{\"type\":\"integer\"}},{\"name\":\"filter[since]\",\"in\":\"query\",\"schema\":{\"type\":\"string\"}},{\"name\":\"Accept\",\"in\":\"header\",\"schema\":{\"type\":\"string\"}}]}}}}",
  )
  let expected = @json.parse(
    "{\"schemaVersion\":2,\"ok\":true,\"complete\":true,\"operations\":[{\"id\":\"repos/list-commits\",\"method\":\"GET\",\"path\":\"/repos/{owner}/{repo}/commits\",\"template\":\"/repos/{owner}/{repo}/commits{?per_page,filter%5Bsince%5D}\",\"parameters\":[{\"name\":\"owner\",\"in\":\"path\",\"required\":true,\"shape\":\"scalar\",\"variable\":\"owner\"},{\"name\":\"repo\",\"in\":\"path\",\"required\":true,\"shape\":\"scalar\",\"variable\":\"repo\"},{\"name\":\"per_page\",\"in\":\"query\",\"required\":false,\"shape\":\"scalar\",\"variable\":\"per_page\"},{\"name\":\"filter[since]\",\"in\":\"query\",\"required\":false,\"shape\":\"scalar\",\"variable\":\"filter%5Bsince%5D\"},{\"name\":\"Accept\",\"in\":\"header\",\"required\":false,\"shape\":\"scalar\",\"variable\":null}],\"unsupported\":[],\"example\":null}],\"diagnostics\":[],\"truncated\":{\"errors\":0,\"warnings\":0}}",
  )
  assert_eq(analyze(doc).to_json(), expected)
}

