test "JS analysis parity fixture 0" {
  let doc = @json.parse(
    "{\"openapi\":\"3.1.0\",\"paths\":{\"/a/{s}/{l}/{m}/{e}\":{\"get\":{\"operationId\":\"op\",\"parameters\":[{\"name\":\"s\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"}},{\"name\":\"l\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"},\"style\":\"label\"},{\"name\":\"m\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"},\"style\":\"matrix\"},{\"name\":\"e\",\"in\":\"path\",\"required\":true,\"schema\":{\"type\":\"string\"},\"style\":\"matrix\",\"explode\":true}]}}}}",
  )
  let expected = @json.parse(
    "{\"schemaVersion\":2,\"ok\":true,\"complete\":true,\"operations\":[{\"id\":\"op\",\"method\":\"GET\",\"path\":\"/a/{s}/{l}/{m}/{e}\",\"template\":\"/a/{s}/{.l}/{;m}/{;e}\",\"parameters\":[{\"name\":\"s\",\"in\":\"path\",\"required\":true,\"shape\":\"scalar\",\"variable\":\"s\"},{\"name\":\"l\",\"in\":\"path\",\"required\":true,\"shape\":\"scalar\",\"variable\":\"l\"},{\"name\":\"m\",\"in\":\"path\",\"required\":true,\"shape\":\"scalar\",\"variable\":\"m\"},{\"name\":\"e\",\"in\":\"path\",\"required\":true,\"shape\":\"scalar\",\"variable\":\"e\"}],\"unsupported\":[],\"example\":null}],\"diagnostics\":[],\"truncated\":{\"errors\":0,\"warnings\":0}}",
  )
  assert_eq(analyze(doc).to_json(), expected)
}

