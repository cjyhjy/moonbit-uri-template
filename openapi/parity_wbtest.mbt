  )
  let expected = @json.parse(
    "{\"schemaVersion\":2,\"ok\":true,\"complete\":true,\"operations\":[{\"id\":\"op\",\"method\":\"GET\",\"path\":\"/q\",\"template\":\"/q\",\"parameters\":[{\"name\":\"deep\",\"in\":\"query\",\"required\":false,\"shape\":\"scalar\",\"variable\":null}],\"unsupported\":[{\"name\":\"deep\",\"in\":\"query\",\"reason\":\"style deepObject has no RFC 6570 equivalent\"}],\"example\":\"/q\"}],\"diagnostics\":[],\"truncated\":{\"errors\":0,\"warnings\":0}}",
  )
  assert_eq(analyze(doc).to_json(), expected)
}

